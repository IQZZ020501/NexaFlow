# Runtime environment: development, test, or production.
ENVIRONMENT=development

# Logging level for the API and Celery workers: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# PostgreSQL connection string used by FastAPI and Alembic.
DATABASE_URL=postgresql+psycopg://nexaflow:nexaflow@localhost:5432/nexaflow

# Required. JWT signing secret; no code default, must be set in .env.
JWT_SECRET_KEY=eabbbd03-85d4-4efb-9056-e610247086c7

# Required. Secret used to encrypt provider API keys at rest; no code default.
MODEL_SECRET_KEY=01025024-57f8-401c-a581-694cfed47d02

# Required. Directory used to store uploaded knowledge documents; no code default.
KNOWLEDGE_STORAGE_DIR=./storage/knowledge

# Required. Qdrant endpoint used for knowledge vector collections; no code default.
QDRANT_URL=http://127.0.0.1:6333

# Optional API key for a secured Qdrant deployment.
QDRANT_API_KEY=

# Required. Redis broker used by Celery knowledge parsing and indexing workers.
CELERY_BROKER_URL=redis://localhost:6379/0

# Allow MCP servers on loopback or private networks. Keep false unless the
# deployment intentionally connects to trusted internal MCP services.
MCP_ALLOW_PRIVATE_NETWORKS=false

# Timeout for MCP discovery and tool calls.
MCP_REQUEST_TIMEOUT_SECONDS=30

# Access token lifetime in minutes.
JWT_EXPIRES_MINUTES=1440

# Refresh session lifetime in days.
REFRESH_TOKEN_EXPIRES_DAYS=30

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial global admin account created during bootstrap.
# The first login must change this password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=NexaFlow@123..
