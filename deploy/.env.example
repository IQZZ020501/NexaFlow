# Shared deployment configuration for deploy/docker-compose.yml.
# Copy to deploy/.env and adjust secrets before starting the stack.

# --- PostgreSQL (defaults match the compose file) ---
POSTGRES_DB=nexaflow
POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=change-me

# --- Backend application ---
# Database URL is assembled from POSTGRES_* above; do not override DATABASE_URL
# unless you use an external database.
JWT_SECRET_KEY=change-me-long-random-string
MODEL_SECRET_KEY=change-me-another-long-random-string
ENVIRONMENT=production

# Bootstrap global admin account (created on first start).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=NexaFlow Admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Default workspace and team seeded for the bootstrap admin.
DEFAULT_WORKSPACE_NAME=Default Workspace
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_TEAM_NAME=Default Team
DEFAULT_TEAM_SLUG=default

# Frontend origin allowed by CORS (Next.js dev server or the public host).
CORS_ORIGINS=http://localhost:3000
