# Shared deployment configuration for deploy/docker-compose.yml.
# Copy to deploy/.env and adjust secrets before starting the stack.

# --- PostgreSQL ---
# Credentials must match backend/.env's DATABASE_URL (default
# nexaflow/nexaflow/nexaflow): both configure the same database, one accessed
# from the host (localhost) and one from the compose network. Override both in
# lockstep with strong secrets for production.
POSTGRES_DB=nexaflow
POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=nexaflow

# --- Backend application ---
# Database URL is assembled from POSTGRES_* above; do not override DATABASE_URL
# unless you use an external database.
JWT_SECRET_KEY=eabbbd03-85d4-4efb-9056-e610247086c7
MODEL_SECRET_KEY=01025024-57f8-401c-a581-694cfed47d02
ENVIRONMENT=production
JWT_EXPIRES_MINUTES=1440
REFRESH_TOKEN_EXPIRES_DAYS=30
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_EXECUTOR_LEASE_SECONDS=90
AGENT_EXECUTOR_HEARTBEAT_SECONDS=30
AGENT_EVENT_POLL_SECONDS=0.5
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_REQUEST_TIMEOUT_SECONDS=30

# Bootstrap global admin account (created on first start).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=NexaFlow@123..

# Frontend origin allowed by CORS (Next.js dev server or the public host).
CORS_ORIGINS=http://localhost:3000
