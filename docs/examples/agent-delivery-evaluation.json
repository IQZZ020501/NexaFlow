{
  "gate": {"minimum_pass_rate": 1.0},
  "cases": [
    {
      "id": "csv-to-xlsx",
      "category": "file-data",
      "goal": "将以下 CSV 转为 sales.xlsx，工作表名称 Data。数量和单价必须是数字，D 列为每行金额数值，D4 为总金额数值。CSV：\n产品,数量,单价\n甲,3,12\n乙,2,20\n请交付文件。",
      "expect": {"files": [{"path": "sales.xlsx", "cells": {"Data!A2": "甲", "Data!B2": 3, "Data!D2": 36, "Data!D3": 40, "Data!D4": 76}}]},
      "follow_ups": [
        {"goal": "修改刚才的 sales.xlsx，将甲的数量改为 4，重算金额与总额，保留其他数据和工作表名称，仍交付 sales.xlsx。", "expect": {"files": [{"path": "sales.xlsx", "changed": true, "cells": {"Data!B2": 4, "Data!D2": 48, "Data!D3": 40, "Data!D4": 88}}]}},
        {"goal": "再次读取现有 sales.xlsx，将乙的单价改为 25，重算金额与总额，甲的数量保持 4。仍交付 sales.xlsx。", "expect": {"files": [{"path": "sales.xlsx", "changed": true, "cells": {"Data!B2": 4, "Data!C3": 25, "Data!D2": 48, "Data!D3": 50, "Data!D4": 98}}]}}
      ]
    },
    {
      "id": "chinese-docx",
      "category": "file-report",
      "goal": "请制作中文 Word 报告 report.docx，标题为季度交付报告。明确包含：本季度交付 12 个项目，其中完成 10 个，进行中 2 个。加入汇总表和下季度工作建议。",
      "expect": {"files": [{"path": "report.docx", "text_contains": ["季度交付报告", "12", "10", "2"]}]}
    },
    {
      "id": "chinese-pdf",
      "category": "file-report",
      "goal": "制作中文 PDF 报告 report.pdf，标题为季度交付报告，正文必须包含可选择文字：本季度交付 12 个项目。说明完成 10 个、进行中 2 个，不要使用整页截图代替文字。",
      "expect": {"files": [{"path": "report.pdf", "text_contains": ["季度交付报告", "12", "10"], "min_pages": 1}]}
    },
    {
      "id": "source-to-pptx",
      "category": "file-presentation",
      "goal": "根据以下资料制作 deck.pptx，至少 3 页：标题为季度交付；本季度交付 12 个项目，完成 10 个、进行中 2 个；下季度目标为缩短交付周期并完善验收。必须保留上述数字和目标。",
      "expect": {"files": [{"path": "deck.pptx", "text_contains": ["季度交付", "12", "10", "2", "验收"], "min_slides": 3}]}
    },
    {
      "id": "edit-a-b-a",
      "category": "file-history",
      "goal": "创建两个 UTF-8 文本文件 a.txt 和 b.txt，内容分别为 A original 和 B original。交付两个文件。",
      "expect": {"files": [{"path": "a.txt", "text_contains": ["A original"]}, {"path": "b.txt", "text_contains": ["B original"]}]},
      "follow_ups": [
        {"goal": "读取已有 b.txt，把内容修改为 B revised。交付 b.txt。", "expect": {"files": [{"path": "b.txt", "changed": true, "text_contains": ["B revised"], "text_not_contains": ["B original"]}]}},
        {"goal": "读取第一轮已有的 a.txt，把内容修改为 A final。不要修改 b.txt。交付 a.txt。", "expect": {"files": [{"path": "a.txt", "changed": true, "text_contains": ["A final"], "text_not_contains": ["A original"]}]}}
      ]
    }
  ]
}
