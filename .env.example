# Copy to .env and replace all production credentials and secrets.
# Database
POSTGRES_DB=nexaflow
POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=nexaflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Application secrets
JWT_SECRET_KEY=replace-with-a-random-32-byte-jwt-secret
MODEL_SECRET_KEY=replace-with-a-random-32-byte-model-secret

# OpenSandbox
OPENSANDBOX_URL=http://127.0.0.1:8088
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=nexaflow/execution:local
OPENSANDBOX_EGRESS_DOMAINS=

# Initial accounts
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=NexaFlow@123..
MANAGED_USER_INITIAL_PASSWORD=NexaFlow@123..
