# Copy to .env and replace all production credentials and secrets.
# Database
POSTGRES_DB=nexaflow
POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=nexaflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# OpenSandbox
OPENSANDBOX_URL=http://127.0.0.1:8088
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=nexaflow/execution:local
OPENSANDBOX_EGRESS_DOMAINS=
# Live sandboxes allowed across all workers; 0 leaves creation unbounded.
# Production requires a positive host limit.
OPENSANDBOX_MAX_SANDBOXES=0
# Prewarmed guests; requires OPENSANDBOX_MAX_SANDBOXES.
OPENSANDBOX_WARM_POOL_SIZE=0
# Live sandboxes per external consumer of a public or API Run.
OPENSANDBOX_MAX_SANDBOXES_PER_CONSUMER=2
# Live sandboxes per workspace, for every Run including console Runs.
OPENSANDBOX_MAX_SANDBOXES_PER_WORKSPACE=2
# Allow a plaintext control plane. Only for a loopback control plane;
# production otherwise requires https because the key travels with every request.
OPENSANDBOX_ALLOW_INSECURE_HTTP=0
# Workflow code node budget in seconds.
WORKFLOW_SANDBOX_TIMEOUT_SECONDS=5
# Document and Skill rendering budget in seconds.
ARTIFACT_SANDBOX_TIMEOUT_SECONDS=30

# Initial accounts
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=NexaFlow@123..
MANAGED_USER_INITIAL_PASSWORD=NexaFlow@123..
