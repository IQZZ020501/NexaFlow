# Shared configuration for host backend commands and Docker Compose.
# Copy this file to .env at the repository root and replace production secrets.
# Use single quotes for literal values containing spaces, #, or $. Do not use
# ${VAR} expansion: host and Compose processes must receive the same literal.

# Compose image tags. Local builds can keep the defaults. For pull-only server
# deployments, replace both values with images published under your registry.
NEXAFLOW_APP_IMAGE=nexaflow/app:local
NEXAFLOW_POSTGRES_IMAGE=nexaflow/postgres-pg-search:0.25.2

# PostgreSQL. The backend safely builds DATABASE_URL from these components when
# DATABASE_URL is empty. Compose overrides only host/port for container access.
POSTGRES_DB=nexaflow
POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=nexaflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full host-side override. When set, its user, password, and database
# must match any POSTGRES_* components above.
DATABASE_URL=

# Runtime environment: development, test, or production. The base Compose file
# overrides this to production; the development worker overrides it back.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required application secrets.
JWT_SECRET_KEY=replace-with-a-random-32-byte-jwt-secret
MODEL_SECRET_KEY=replace-with-a-random-32-byte-model-secret

# Host-side storage and service endpoints. Compose overrides these paths/hosts.
KNOWLEDGE_STORAGE_DIR=./storage/knowledge
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
CELERY_BROKER_URL=redis://localhost:6379/0

# Allow MCP servers on loopback or private networks only for trusted deployments.
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_REQUEST_TIMEOUT_SECONDS=30

# Model and Agent execution limits.
MODEL_REQUEST_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_EXECUTOR_LEASE_SECONDS=90
AGENT_EXECUTOR_HEARTBEAT_SECONDS=30
AGENT_EVENT_POLL_SECONDS=0.5

# Unix socket exposed only to the Compose worker by the isolated code sandbox.
WORKFLOW_SANDBOX_SOCKET=/run/sandbox/sandbox.sock
WORKFLOW_SANDBOX_TIMEOUT_SECONDS=5

# Fixed-window limits for public-link and Agent API run creation.
AGENT_EXTERNAL_AGENT_RUNS_PER_MINUTE=60
AGENT_EXTERNAL_CONSUMER_RUNS_PER_MINUTE=10

# Authentication and browser access.
JWT_EXPIRES_MINUTES=1440
REFRESH_TOKEN_EXPIRES_DAYS=30
NEXAFLOW_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Initial global admin account created during bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=NexaFlow@123..

# Shared initial password assigned to administrator-created users.
MANAGED_USER_INITIAL_PASSWORD=NexaFlow@123..
